# Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@host:5432/edwardian?sslmode=require"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000
NODE_ENV=development

# CORS - Frontend URL (for production, set to your Vercel frontend URL)
FRONTEND_URL="http://localhost:3000"

# Email (PHP Mailer on Whogohost)
PHP_MAILER_URL="https://edwardianeducationalconsult.com.ng/mailer/send.php"
PHP_MAILER_KEY="eiec-mailer-2026"
FROM_EMAIL="registrar@edwardianeducationalconsult.com.ng"

# Termii SMS
TERMII_API_KEY="TL_xxxxxxxxxxxxx"
TERMII_SENDER_ID="EdwardIan"

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Web Push (browser + mobile-app push notifications)
# The pair below is a real, working sample so you can test locally right away —
# but generate your OWN before deploying to production: node scripts/generate-vapid-keys.js
# (whoever holds VAPID_PRIVATE_KEY can send push notifications as your app, so
# don't reuse this sample key or commit your real one).
