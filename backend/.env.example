# Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@host:5432/edwardian?sslmode=require"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000
NODE_ENV=development

# CORS - Frontend URL (for production, set to your Vercel frontend URL)
FRONTEND_URL="http://localhost:3000"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET=""

# Brevo Email
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="noreply@edwardianconsult.com"
BREVO_SENDER_NAME="Edwardian Educational Consult"

# Termii SMS
TERMII_API_KEY="TL_xxxxxxxxxxxxx"
TERMII_SENDER_ID="EdwardIan"

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
